#!/bin/zsh

# Keep the symlink's directory out of lookup so this wrapper cannot find itself.
wrapper_dir=${0:a:h}
path=( ${path:#$wrapper_dir} )
pi_command="${commands[pi]}"

if [[ -z $pi_command ]]; then
    print -u2 "pi: underlying pi executable not found"
    exit 127
fi

exec "$wrapper_dir/aws-login" ep-playground.Europace-DevOps -- "$pi_command" "$@"
