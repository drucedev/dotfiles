#!/bin/zsh

if (( $# > 0 )); then
    account=$1
    shift
else
    account="$(FZF_DEFAULT_COMMAND='awsume -l' fzf --ansi | awk '{ print $1 }')" || exit
    [[ -n $account ]] || exit 1
fi

aws-sso-util login || exit
awsume_command="${commands[awsume]}"
if [[ -z $awsume_command ]]; then
    print -u2 "aws-login: awsume executable not found"
    exit 127
fi
source "$awsume_command" "$account" || exit

if [[ ${1:-} == -- ]]; then
    shift
fi

if (( $# > 0 )); then
    exec "$@"
fi

exec "${SHELL:-/bin/zsh}" -l
