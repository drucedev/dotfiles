#!/bin/zsh

hypoport_api_key="$(op read "op://kqulf33u7asgjh4vw5tjtaji5u/doypcrvws4eg3gfpjal2q7dupy/credential")" || exit
export HYPOPORT_API_KEY="$hypoport_api_key"

wrapper_dir=${0:a:h}
path=( ${path:#$wrapper_dir} )
opencode_command="${commands[opencode]}"
if [[ -z $opencode_command ]]; then
    print -u2 "opencode: underlying executable not found"
    exit 127
fi

