#!/bin/sh
set -eu

awww-daemon >/dev/null 2>&1 &

ready=0
for _ in $(seq 1 50); do
	if query=$(awww query 2>/dev/null); then
		ready=1
		break
	fi
	sleep 0.1
done

if [ "$ready" -ne 1 ]; then
	exit 1
fi

if printf '%s\n' "$query" | grep -qiE 'no wallpaper|no image'; then
	awww img "$HOME/Pictures/walls/wallpaper.jpg"
else
	awww restore
fi
