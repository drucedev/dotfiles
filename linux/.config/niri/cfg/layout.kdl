    layout {
        gaps 16 // Gap between windows
	    always-center-single-column
        center-focused-column "never" // Don’t auto-center focused column

        background-color "transparent"

	default-column-width { proportion 0.66667; }

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

	focus-ring {
	    on
	    width 2
	    active-color "#cba6f7"
	    inactive-color "#585b70"
	}

        struts {}
    }

// Named workspaces always exist. Names are unique across outputs, so these are
// roles; declaration order is the index on that output. Other workspaces are
// created only when used.
workspace "terminal" { open-on-output "DP-5"; }
workspace "code" { open-on-output "DP-5"; }
workspace "apps" { open-on-output "DP-5"; }
workspace "discord" { open-on-output "HDMI-A-5"; }
workspace "browser" { open-on-output "HDMI-A-5"; }
