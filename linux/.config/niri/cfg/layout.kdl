    layout {
        gaps 8 // Gap between windows
	always-center-single-column
        center-focused-column "never" // Don’t auto-center focused column

        background-color "#1e1e2e"

	default-column-width { proportion 0.66667; }	

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

	focus-ring {
	    on
	    width 2
	    active-color "#f5e0dc"
	}

        struts {}
    }
