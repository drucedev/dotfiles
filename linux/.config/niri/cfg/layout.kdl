    layout {
        gaps 16 // Gap between windows
	    always-center-single-column
        center-focused-column "never" // Don’t auto-center focused column

        background-color "transparent"

	default-column-width { proportion 0.66667; }

        preset-column-widths {
            proportion 0.33333
            proportion 0.5
            proportion 0.66667
        }

	focus-ring {
	    on
	    width 2
	    active-color "#cba6f7"
	    inactive-color "#585b70"
	}

        struts {}
    }

// Persistent workspaces 1-4, shown in the waybar
workspace "1" { open-on-output "DP-5"; }
workspace "2" { open-on-output "DP-5"; }
workspace "3" { open-on-output "DP-5"; }
workspace "4" { open-on-output "DP-5"; }
