# Shared appearance and behavior.
config-file = common.conf

# Let the compositor decide the window state instead of requesting maximize.
# GTK's native mode with its titlebar disabled leaves only an auto-hiding tab
# bar, which is the closest Linux equivalent to macOS's tabs titlebar.
gtk-titlebar-style = native
gtk-titlebar = false
window-show-tab-bar = auto

# Use the macOS shortcut layout with Ctrl in place of Command. Keep
# Ctrl+Shift+C/V for clipboard operations so Ctrl+C remains available to
# terminal programs when this config is used with older Ghostty versions.
keybind = clear

# Configuration and clipboard
keybind = ctrl+shift+,=reload_config
keybind = ctrl+,=open_config
keybind = ctrl+shift+c=copy_to_clipboard:mixed
keybind = ctrl+shift+v=paste_from_clipboard
keybind = ctrl+insert=copy_to_clipboard:mixed
keybind = shift+insert=paste_from_selection

# Font size
keybind = ctrl+==increase_font_size:1
keybind = ctrl++=increase_font_size:1
keybind = ctrl+-=decrease_font_size:1
keybind = ctrl+0=reset_font_size

# Selection and scrolling
keybind = shift+arrow_left=adjust_selection:left
keybind = shift+arrow_right=adjust_selection:right
keybind = shift+arrow_up=adjust_selection:up
keybind = shift+arrow_down=adjust_selection:down
keybind = ctrl+home=scroll_to_top
keybind = ctrl+end=scroll_to_bottom
keybind = ctrl+page_up=scroll_page_up
keybind = ctrl+page_down=scroll_page_down
keybind = ctrl+j=scroll_to_selection
keybind = ctrl+shift+arrow_up=jump_to_prompt:-1
keybind = ctrl+shift+arrow_down=jump_to_prompt:1

# Windows, tabs, and splits
keybind = ctrl+q=quit
keybind = ctrl+n=new_window
keybind = ctrl+w=close_surface
keybind = ctrl+alt+w=close_tab:this
keybind = ctrl+shift+w=close_window
keybind = ctrl+shift+alt+w=close_all_windows
keybind = ctrl+t=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+[=previous_tab
keybind = ctrl+shift+]=next_tab
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=last_tab
keybind = ctrl+d=new_split:right
keybind = ctrl+shift+d=new_split:down
keybind = ctrl+[=goto_split:previous
keybind = ctrl+]=goto_split:next
keybind = ctrl+alt+arrow_up=goto_split:up
keybind = ctrl+alt+arrow_down=goto_split:down
keybind = ctrl+alt+arrow_left=goto_split:left
keybind = ctrl+alt+arrow_right=goto_split:right
keybind = ctrl+shift+alt+arrow_up=resize_split:up,10
keybind = ctrl+shift+alt+arrow_down=resize_split:down,10
keybind = ctrl+shift+alt+arrow_left=resize_split:left,10
keybind = ctrl+shift+alt+arrow_right=resize_split:right,10

# Terminal actions
keybind = ctrl+a=select_all
keybind = ctrl+k=clear_screen
keybind = ctrl+z=undo
keybind = ctrl+shift+z=redo
keybind = ctrl+alt+v=paste_from_selection
keybind = ctrl+enter=toggle_fullscreen
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+alt+i=inspector:toggle

# Search
keybind = ctrl+f=start_search
keybind = ctrl+e=search_selection
keybind = ctrl+shift+f=end_search
keybind = ctrl+g=navigate_search:next
keybind = ctrl+shift+g=navigate_search:previous
keybind = escape=end_search

# Screen file actions
keybind = ctrl+alt+j=write_screen_file:copy,plain
keybind = ctrl+shift+j=write_screen_file:paste,plain
keybind = ctrl+shift+alt+j=write_screen_file:open,plain

# Natural text editing, matching macOS terminal behavior.
keybind = ctrl+arrow_right=text:\x05
keybind = ctrl+arrow_left=text:\x01
keybind = ctrl+backspace=text:\x15
keybind = alt+arrow_left=esc:b
keybind = alt+arrow_right=esc:f
