# Guard against app state entering a folded Stow package if --no-folding is omitted.
**/.config/zed/conversations
**/.config/zed/prompts
**/.config/zed/themes

**/.config/herdr/*
!**/.config/herdr/config.toml

# Only the Pi theme is Stow-managed; settings, backups, and state stay local.
common/.pi/agent/*
!common/.pi/agent/themes/
common/.pi/agent/themes/*
!common/.pi/agent/themes/catppuccin-mocha.json
